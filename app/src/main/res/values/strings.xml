    <!-- Onboarding -->
    <string name="onboarding_title_1">Convert NSZ to NSP</string>
    <string name="onboarding_body_1">This app decompresses .nsz files back to their original .nsp form using the open-source nsz library embedded via Python.</string>
    <string name="onboarding_disclaimer">This app does NOT bundle or distribute keys, ROMs, or any copyrighted material. It only processes files you already own with keys dumped from your own console.</string>
    <string name="onboarding_title_2">You need prod.keys</string>
    <string name="onboarding_body_2">Keys are dumped from your own Switch using tools like Lockpick_RCM. They are used locally only — never transmitted or stored outside your device.</string>
    <string name="onboarding_title_3">Select your prod.keys</string>
    <string name="onboarding_body_3">Pick the prod.keys file to validate and store it. You can swap it later from Settings.</string>
